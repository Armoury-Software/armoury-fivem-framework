{
  "name": "@armoury/fivem-framework-client",
  "version": "1.0.43",
  "description": "Client APIs for the Armoury FiveM framework",
  "main": "dist/cjs/client/index.js",
  "module": "dist/esm/client/index.js",
  "types": "dist/types/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/client/index.d.ts",
      "import": "./dist/esm/client/index.js",
      "require": "./dist/cjs/client/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json && node ../../tools/move_ambientdeclaration.js client"
  },
  "dependencies": {
    "injection-js": "^2.4.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "peerDependencies": {
    "@armoury/fivem-framework-common": "1.0.43"
  },
  "publishConfig": {
    "access": "public"
  }
}