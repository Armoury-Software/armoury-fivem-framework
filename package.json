{
  "name": "@armoury/fivem-framework",
  "version": "1.0.7",
  "description": "The Armoury Framework for FiveM",
  "private": true,
  "workspaces": [
    "packages/common",
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "postinstall": "husky install",
    "build": "npm run build --workspace=@armoury/fivem-framework-common && npm run build --workspace=@armoury/fivem-framework-client && npm run build --workspace=@armoury/fivem-framework-server",
    "build:common": "npm run build --workspace=@armoury/fivem-framework-common",
    "build:client": "npm run build:common && npm run build --workspace=@armoury/fivem-framework-client",
    "build:server": "npm run build:common && npm run build --workspace=@armoury/fivem-framework-server",
    "clean": "node tools/cleanup",
    "package:common": "npm run build:common && npm pack --workspace=@armoury/fivem-framework-common",
    "package:client": "npm run build:client && npm pack --workspace=@armoury/fivem-framework-client",
    "package:server": "npm run build:server && npm pack --workspace=@armoury/fivem-framework-server",
    "test": "jest --no-cache --runInBand",
    "test:cov": "jest --coverage --no-cache --runInBand"
  },
  "keywords": [
    "fivem",
    "typescript",
    "npm",
    "package"
  ],
  "author": "Radu Mazilu @ Armoury <radu.mazilu@armoury.ro>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Armoury-Software/Armoury-FiveM-Framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Armoury-Software/Armoury-FiveM-Framework.git"
  },
  "bugs": {
    "url": "https://github.com/Armoury-Software/Armoury-FiveM-Framework/issues"
  },
  "devDependencies": {
    "@citizenfx/client": "^2.0.7479-1",
    "@citizenfx/server": "^2.0.7479-1",
    "@commitlint/cli": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@types/jest": "^27.0.1",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^20.14.9",
    "@types/webpack-env": "^1.18.5",
    "@typescript-eslint/eslint-plugin": "^4.31.1",
    "@typescript-eslint/parser": "^4.31.1",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^7.0.2",
    "injection-js": "^2.4.0",
    "jest": "^29.7.0",
    "pinst": "^2.1.6",
    "prettier": "^2.4.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.1.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.3",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4"
  }
}
